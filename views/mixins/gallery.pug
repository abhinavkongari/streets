//- Lays stories out in rows of three: two small tiles and one wide tile,
//- with the wide tile swapping sides on every other row.
mixin tile(story, wide)
  if wide
    .grid__item.desk-one-half.lap-and-up-one-half.palm-one-whole
      +tileInner(story, 'square square--1 square--rectangle square--img')
  else
    .grid__item.desk-one-quarter.lap-and-up-one-quarter.palm-one-half
      +tileInner(story, 'square square--img square--3')

mixin tileInner(story, classes)
  div(class=classes)
    if story.image
      span.square__bg(style="background-image: url('" + base + story.image + "');")
    .square__inner
      .square__inner__content
        h3= story.title
        .square-details
          span.name-divider= story.author
          |
          time(datetime=story.date)= formatDate(story.date)
      a.link-wrap(aria-label=story.title, href=base + 'stories/' + story.slug + '.html') Read More

mixin gallery(stories)
  each story, i in stories
    - var row = Math.floor(i / 3), pos = i % 3
    +tile(story, row % 2 === 0 ? pos === 2 : pos === 0)
